    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nlet extractedBody = (item.text || '').trim();\nif (!extractedBody && item.html) {\n  extractedBody = item.html\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\nif (!extractedBody) extractedBody = item.subject || '';\n\nconst subject = (item.subject || '').replace(/^Subject:\\s*/i, '').trim();\nconst sender = item.from?.text || item.from?.value?.[0]?.address || '';\nconst gmail_message_id = item.id || '';\n\nconst binaryKeys = Object.keys($input.item.binary || {});\nconst attachments = [];\nfor (const key of binaryKeys) {\n  const bin = $input.item.binary[key];\n  const buffer = await this.helpers.getBinaryDataBuffer($itemIndex, key);\n  attachments.push({\n    filename: bin.fileName || key,\n    mimetype: bin.mimeType || 'application/octet-stream',\n    data_base64: buffer.toString('base64')\n  });\n}\n\nreturn {\n  json: {\n    subject,\n    body: extractedBody,\n    sender,\n    gmail_message_id,\n    attachments\n  }\n};"
      },
