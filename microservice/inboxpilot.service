# Reference copy of /etc/systemd/system/inboxpilot.service on EC2. Editing this file does not change the server.
[Unit]
Description=InboxPilot FastAPI service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/inbox_pilot/microservice
ExecStart=/home/ubuntu/inbox_pilot/microservice/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
