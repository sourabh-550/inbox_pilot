# Copy to .env and fill in. It can live in microservice/ or the repo root
# (load_dotenv searches upward); the server keeps it in microservice/.env.
# .env is gitignored; never commit real values.

# Groq API key. Used for email classification (classify.py) and OCR of scanned PDFs (attachments.py).
GROQ_API_KEY=
# Optional. Groq classification model; defaults to openai/gpt-oss-120b if empty.
# Strict structured outputs only work on openai/gpt-oss-20b and openai/gpt-oss-120b.
GROQ_MODEL=

# Notion integration token. The integration must be shared with both databases below.
NOTION_TOKEN=
# Notion database IDs (the database, not the data source; the code looks up the data source).
NOTION_SOURCES_DB_ID=
NOTION_ITEMS_DB_ID=

# Telegram bot token (from @BotFather) and the chat ID that alerts and the daily digest go to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres connection string for the dedup table (Supabase),
# e.g. postgresql://user:password@host:5432/postgres
DATABASE_URL=

# Google Calendar doesn't use env vars: it reads microservice/credentials.json
# (OAuth desktop client) and microservice/token.json (made by calendar_auth.py).
